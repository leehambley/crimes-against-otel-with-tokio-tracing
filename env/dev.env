# Test/dev: everything, in detail.
DEPLOY_ENV=dev

# line | pretty | json
LOG_FORMAT=pretty
# Our crates at TRACE, dependencies at INFO.
LOG_FILTER=info,gateway=trace,store=trace,stats=trace,common=trace,telemetry=debug
# Same for spans: DEBUG handler spans and TRACE encode/decode spans are exported.
TRACE_FILTER=info,gateway=trace,store=trace,stats=trace,common=trace,loadgen=trace

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_METRIC_EXPORT_INTERVAL=5000

CHAOS_FAILURE_PCT=5
CHAOS_SLOW_PCT=2
CHAOS_SLOW_MS=1500

# Collector tail sampling: keep everything in dev.
SAMPLING_PERCENT=100
SAMPLING_SLOW_MS=1000
SAMPLING_DECISION_WAIT=5s
