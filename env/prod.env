# Production: quiet logs, request-level traces, heavy sampling.
# Standard OTel resource attributes (service.name is set per container).
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod

LOG_FORMAT=json
# stdout and OTLP logs.
LOG_FILTER=warn
# INFO spans only: request, outbound HTTP, Valkey commands. No handler internals.
TRACE_FILTER=info
# Only WARN/ERROR events are attached to spans as span events.
SPAN_EVENT_LEVEL=warn

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_METRIC_EXPORT_INTERVAL=15000

CHAOS_FAILURE_PCT=1
CHAOS_SLOW_PCT=1
CHAOS_SLOW_MS=1500

# Keep 5% of healthy traces, 100% of failing or slow ones.
SAMPLING_PERCENT=5
SAMPLING_SLOW_MS=1000
SAMPLING_DECISION_WAIT=5s
